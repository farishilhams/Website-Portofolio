# =========================================================
# AI Assistant & Chatbot API Configuration (Optional)
# Jika tidak diisi, chatbot akan otomatis berjalan dalam mode
# Intelligent Local Knowledge Base Rishy secara mulus tanpa error.
# =========================================================

# 1. Groq API (Rekomendasi - Cepat & Free tier luas)
# Dapatkan di: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 2. OpenAI API
# Dapatkan di: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 3. NVIDIA NIM API
# Dapatkan di: https://build.nvidia.com
NVIDIA_APIKEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# =========================================================
# Email Contact Form Configuration
# =========================================================
EMAIL_USER=
EMAIL_PASS=
